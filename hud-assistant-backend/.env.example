# ID público do aplicativo Urfilig no Spotify Developer Dashboard.
# Configure uma vez no backend; usuários só fazem login e autorizam a própria conta.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DIRECT_URL=postgresql://usuario:senha@host/banco?sslmode=require
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
SPOTIFY_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
CONTACTS_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ajuste apenas se precisar sobrescrever a fila padrão para o pooler do Neon.
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT=20
# API própria do Urfilig usada somente para responder mensagens do chat.
URFILIG_API_URL=http://127.0.0.1:8780
# Recomendado quando suportado pela API; enviado no cabeçalho X-Urfilig-Token.
URFILIG_API_TOKEN=
# Evolução de personalidade desativada; não são gerados traços sem modelo generativo.
PERSONA_EVOLUTION_ENABLED=false
# GitHub App (futura integração do Dev Agent; não usar token pessoal)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

PIPER_LENGTH_SCALE=1.0
