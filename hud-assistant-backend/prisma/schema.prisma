generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                  String              @id @default(cuid())
  email               String              @unique
  nome                String?
  senhaHash           String?
  googleId            String?             @unique
  criadoEm            DateTime            @default(now())
  idade               Int?
  localizacao         String?
  profissao           String?
  hobbies             String?
  onboardingConcluido Boolean             @default(false)
  itensAgenda         AgendaItem[]
  bordoes             Bordao[]
  contatos            Contato[]
  tarefasDevAgent     DevAgentTask[]
  diretrizes          Diretriz[]
  estatisticasUso     EstatisticaUso[]
  eventosCalendario   Evento[]
  leads               Lead[]
  memorias            Memory[]
  notas               Nota[]
  pastas              Pasta[]
  reflexoes           Reflexao[]
  registrosEmocionais RegistroEmocional[]
  temperamentos       Temperamento[]
}

model Evento {
  id         String    @id @default(cuid())
  usuarioId  String
  titulo     String
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime?
  cor        String?   @default("#3b82f6")
  etiqueta   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String    @id @default(cuid())
  usuarioId       String
  nome            String
  contato         String
  nicho           String?
  bio             String?
  score           Int?
  statusFunil     String    @default("AGUARDANDO_APROVACAO")
  pitch           String?
  ultimaInteracao DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, contato])
}

model Memory {
  id         String       @id @default(cuid())
  usuarioId  String
  categoria  String
  titulo     String
  conteudo   String
  tags       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  usuario    Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  linksSaida MemoryLink[] @relation("LinksDeOrigem")
}

model MemoryLink {
  id        String @id @default(cuid())
  origemId  String
  destinoId String
  origem    Memory @relation("LinksDeOrigem", fields: [origemId], references: [id])

  @@unique([origemId, destinoId])
}

model Diretriz {
  id        String   @id @default(cuid())
  usuarioId String
  conteudo  String
  tags      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Reflexao {
  id        String   @id @default(cuid())
  usuarioId String
  conteudo  String
  data      DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Temperamento {
  id           String   @id @default(cuid())
  usuarioId    String
  traco        String
  intensidade  Int      @default(1)
  evidencia    String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Bordao {
  id         String   @id @default(cuid())
  usuarioId  String
  situacao   String
  texto      String
  vezesUsado Int      @default(0)
  createdAt  DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model RegistroEmocional {
  id                  String   @id @default(cuid())
  usuarioId           String
  sentimentoDetectado String
  contexto            String
  respostaDada        String?
  createdAt           DateTime @default(now())
  usuario             Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model EstatisticaUso {
  id        String   @id @default(cuid())
  usuarioId String
  tipo      String
  detalhe   String?
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model AgendaItem {
  id        String   @id @default(cuid())
  usuarioId String
  titulo    String
  horario   String?
  data      DateTime @default(now())
  concluido Boolean  @default(false)
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Pasta {
  id        Int      @id @default(autoincrement())
  usuarioId String
  nome      String
  createdAt DateTime @default(now())
  notas     Nota[]
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Nota {
  id          Int      @id @default(autoincrement())
  pastaId     Int?
  usuarioId   String
  titulo      String
  conteudo    String
  importante  Boolean  @default(false)
  ordem       Int      @default(0)
  dataCriacao DateTime @default(now())
  pasta       Pasta?   @relation(fields: [pastaId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Contato {
  id                     String    @id @default(cuid())
  usuarioId              String
  nome                   String
  telefone               String?
  email                  String?
  dataContato            DateTime?
  tipoData               String?   @default("PROXIMO_CONTATO")
  status                 String?   @default("LEAD")
  perfilInvestidor       String?
  patrimonioEstimado     String?
  objetivoFinanceiro     String?
  anotacoes              String?
  consentimentoContatoEm DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  usuario                Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model DevAgentTask {
  id          String             @id @default(cuid())
  usuarioId   String
  repositorio String
  descricao   String
  status      DevAgentTaskStatus @default(PLANEJADA)
  plano       Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  usuario     Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt])
}

enum DevAgentTaskStatus {
  PLANEJADA
  AGUARDANDO_APROVACAO
  APROVADA
  EM_EXECUCAO
  CONCLUIDA
  BLOQUEADA
  CANCELADA
}
