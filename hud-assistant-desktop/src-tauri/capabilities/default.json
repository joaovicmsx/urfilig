{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Permissões padrão da janela principal da Urfilig",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/**"
        }
      ]
    }
  ]
}
