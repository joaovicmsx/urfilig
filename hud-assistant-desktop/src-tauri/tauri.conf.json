{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Urfilig",
  "version": "0.1.0",
  "identifier": "com.urfilig.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../hud-assistant-frontend",
    "beforeBuildCommand": "npm run build --prefix ../hud-assistant-frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../hud-assistant-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Urfilig",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "login.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../hud-assistant-backend": "hud-assistant-backend"
    }
  }
}
